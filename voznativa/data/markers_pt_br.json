  },
  "patterns": [
    {
      "label": "commitment.commit",
      "regex": "\\b(?:estaremos|estarei|vamos estar|iremos estar|vou estar|estaremos sendo)\\s+\\w+ndo\\b",
      "doc": "future progressive (gerundismo) still expresses a commitment"
    },
    {
      "label": "quantifier.upper_bound",
      "regex": "\\bat[eé](?=\\s+(?:\\d|dois\\b|duas\\b|tr[eê]s\\b|quatro\\b|cinco\\b|seis\\b|sete\\b|oito\\b|nove\\b|dez\\b|vinte\\b|trinta\\b|cem\\b))",
      "doc": "até directly before a number is an upper bound (em até 5 dias) or a deadline (até 31/12); both must survive"
    },
    {
      "label": "causality.causal",
      "regex": "\\b(?:faz|fez|fazem|fizeram|fará|farão|fazia|faria|fizesse)\\b(?=\\s+(?:(?!para\\b|pra\\b|com\\b)[\\w-]+\\s+){1,3}?[\\w-]+(?:ar|er|ir|or)\\b)",
      "doc": "causative fazer + subject + infinitive (um vazamento fez o servidor reiniciar); 'para' excluded to avoid purpose clauses"
    },
    {
      "label": "causality.causal",
      "regex": "\\b(?:leva|levou|levam|levaram|levará|levaria)\\b(?=\\s+(?:(?!para\\b|pra\\b)[\\w-]+\\s+){1,3}?(?:a|à)\\s+[\\w-]+(?:ar|er|ir|or)\\b)",
      "doc": "causative levar + object + a + infinitive; only the verb is the marker so cause/effect stay comparable"
    }
  ],
  "comparison": {
    "category_level": [
      "negation"
    ],
    "_doc": "for these categories only the category total is compared, so não é possível <-> é impossível is not a flip",
    "severity": {
      "_doc": "localized changes in these categories fail; others need review. Additions of causal connectives need review because they may only make an implied relation explicit; removals and correlation->causation shifts fail.",
      "critical_when_localized": [
        "negation",
        "modality",
        "causality"
      ],
      "review_only_on_addition": [
        "causality.causal"
      ],
      "informational": [
