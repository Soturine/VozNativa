  "context_rules": {
    "se": "counted as conditional only at clause start: sentence-initial, after , ; : ( or after e/mas/ou/só/somente/apenas/porém. Elsewhere it is usually the clitic pronoun (vende-se, ela se machucou).",
    "negative_concord": "n-words (nenhum, nada, ninguém, nunca, jamais, nem) after não/nn in the same sentence are relabeled negation_concord.n_word and not counted as extra negations",
    "idioms": "fixed expressions where só/não lose their usual meaning (é só = basta, só que = mas, não só... mas = additive) are consumed as idiom.fixed and are informational; politeness formulas (não hesite em, não deixe de) and conforme + participle (conforme alinhado = as agreed) are idioms, not negation or attribution (both found in real model runs); 'cada vez mais/menos' (increasingly) and courtesy 'sempre à disposição' are not universal quantifiers (found in the 2026-10-20 real run)",
    "polarity": "a polarity class appearing or disappearing alone is informational ('falha' -> 'bug'); only a flip to its antonym class in an aligned sentence fails (polarity_flipped). Entries ending in * match by prefix."
  },
  "known_gaps": [
    "morphological negation is covered only for the listed compounds; desabilitar, inválido, ilegal etc. are not counted",
    "lexical antonyms (aumentou/diminuiu, aprovado/reprovado) are invisible to marker counts",
    "deve is ambiguous between necessity and epistemic probability; it is always counted as necessity",
    "um/uma are not treated as numbers because they are usually articles",
    "antonyms outside the polarity lexicon (avançou/travou, ganhou/empatou) are invisible"
  ],
  "compounds": {
    "_doc": "single words that encode two meanings; each listed label is counted once",
    "impossível": [
