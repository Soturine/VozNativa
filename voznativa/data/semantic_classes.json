      "final",
      "finais",
      "total",
      "totais",
      "oficial",
      "oficiais"
    ],
    "_setting_nouns": "simulador, emulador, simulação are nouns on purpose: 'no emulador' is the setting itself, so they are not skipped after a determiner"
  },
